# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Runtime mode: development | test | production
# Drives morgan's log format, cookie `secure`/`sameSite`, and whether the app
# refuses to boot on a weak JWT secret.
NODE_ENV=development

# Port the HTTP server binds to.
PORT=5000

# Mongo connection string.
# Local:  mongodb://127.0.0.1:27017/sevadesk
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/sevadesk?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sevadesk

# Secret used to sign the session JWT.
# REQUIRED in production and must be >= 32 characters; the process refuses to
# start otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development a throwaway fallback is used if this is left blank, so that
# `npm test` and a bare `node -e "import('./src/app.js')"` work with no setup.
JWT_SECRET=

# How long a session cookie / JWT stays valid. Accepts a number followed by
# s, m, h or d. Keep this <= the cookie maxAge, which is derived from it.
JWT_EXPIRES_IN=7d

# bcrypt work factor for password hashing. 12 is the current sane default.
# Lowering it to 10 roughly halves hash time and weakens offline-attack
# resistance. Changing it does NOT invalidate existing hashes.
BCRYPT_SALT_ROUNDS=12

# Comma-separated list of browser origins allowed to send credentialed
# requests. CORS uses this as an explicit allow-list with `credentials: true`,
# because a wildcard origin is rejected by browsers whenever cookies are
# involved. Must be exact origin strings (scheme + host + port), no trailing
# slash. In production this must contain the deployed frontend's origin.
ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting window, in milliseconds (900000 = 15 minutes). Shared by every
# limiter below.
RATE_LIMIT_WINDOW_MS=900000

# Default / global request ceiling per window per IP. Generous: it exists to
# blunt scripted abuse, not to get in a receptionist's way.
RATE_LIMIT_MAX=100

# Login attempts per window per IP. Correct logins are not counted
# (skipSuccessfulRequests), so only failures burn this budget.
AUTH_RATE_LIMIT_MAX=10

# New requests/jobs created per window per IP.
REQUEST_CREATE_RATE_LIMIT_MAX=60

# Guard rail for `npm run seed`. The seed script wipes and rewrites the
# database, so it refuses to run when NODE_ENV=production unless this is
# exactly true. Keep it false in any real environment.
ALLOW_PROD_SEED=false
